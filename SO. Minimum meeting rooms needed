 public int minRooms(int[][] meet) {
        Arrays.sort(meet,(a, b)-> a[0] - b[0]);
        int n = meet.length, k = 0, room = 0;
        PriorityQueue<Integer> pq = new PriorityQueue<>();
        for(int i = 0; i < n; i++) {
            if(!pq.isEmpty() && pq.peek() <= meet[i][0]) {
                pq.poll();
            }
            pq.offer(meet[i][1]);
        }
        return pq.size();

    }
