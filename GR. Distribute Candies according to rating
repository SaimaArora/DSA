    public int distributeCandies(int children, int[] ratings) {
        int[] candy = new int[children];
        Arrays.fill(candy, 1);
        for(int i = 1; i < children; i++) {
            if(ratings[i] > ratings[i - 1]) {
                candy[i] = candy[i - 1] +1;
            }
        }
        for(int i = children - 2; i >= 0; i--) {
            if(ratings[i] > ratings[i + 1]) {
                candy[i] = Math.max(candy[i], candy[i+1]);
            }
        }
        int res = 0;
        for(int c:candy) res+=c;
        return res;
    }
