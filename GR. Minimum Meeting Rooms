    public int minRoomsMeeting2(int[][] meet) {
        int n = meet.length, ind = 0;
        int st[] = new int[n];
        int[] end = new int[n];

        for(int[] curr:meet) {
            st[ind] = curr[0];
            end[ind++] = curr[1];
        }
        Arrays.sort(st);
        Arrays.sort(end);
        int e = 0, s= 0, count = 0, maxAns = 0;
        while(s < n) {
            if(st[s] < end[e]) {
                count++;
                s++;
            } else {
                count--;
                e++;
            }
            maxAns = Math.max(maxAns, count);
        }
        return maxAns;
    }
