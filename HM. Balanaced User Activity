    public int balancedUserActivity(int[] log) {
        int sum = 0, maxLen = 0;
        HashMap<Integer, Integer> map = new HashMap<>();
        for(int i = 0;i < log.length; i++) {
            sum+=log[i];
            if(map.containsKey(sum)) {
                maxLen = Math.max(maxLen, i - map.get(sum));
            }
            else map.put(sum, i);
        }
        return maxLen;
    }
