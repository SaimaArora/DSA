    //0-empty, 1-healthy, 2-infected
    public int virusSpreads(int[][] grid) {
        Queue<int[]> q = new LinkedList<>();
        int n = grid.length, m = grid[0].length, healthy = 0;
        for(int i = 0; i < n; i++) {
            for(int j = 0; j < m; j++) {
                if(grid[i][j] == 1) healthy++;
                else if(grid[i][j] == 2) {
                    q.offer(new int[]{i, j});
                }
            }
        }
        int time = 0;
        while(!q.isEmpty()) {
            int len = q.size();
            boolean spread = false;
            for(int l = 0; l < len; l++) {
                int[] curr = q.poll();
                int[] rows = {0, 0, -1, 1};
                int[] cols = {1, -1, 0, 0};

                for (int k = 0; k < 4; k++) {
                    int newr = rows[k] + curr[0], newc = cols[k] + curr[1];
                    if (newr >= 0 && newc >= 0 && newr < n && newc < m && grid[newr][newc] == 1) {
                        if (grid[newr][newc] == 1) healthy--;
                        if (healthy == 0) return time+1;
                        grid[newr][newc] = 2;
                        q.offer(new int[]{newr, newc});
                        spread = true;
                    }
                }
            }
            if(spread) time++;
        }
        return healthy==0? time: -1;
    }

